# 云帐房综合活动平台 · 原型环境变量（复制为 .env 填写）
PORT=3000
BASE_URL=http://localhost:3000
DATA_DIR=./data
JWT_SECRET=change-me-in-prod
ADMIN_PASSWORD=admin123

# 钉钉企业内部应用（内部员工免登）；留空则进入开发态（返回 dev 员工）
DINGTALK_APPKEY=
DINGTALK_APPSECRET=

# 外部参与者（院校学生）短信：原型期用开发验证码，生产期接 M10 短信通道
DEV_SMS_CODE=123456

# 可选：GitHub 同步（与现有 workbuddy001 一致）。留空则仅本地 JSON
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_BRANCH=main
